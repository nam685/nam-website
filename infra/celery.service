[Unit]
Description=Celery Worker for nam-website
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=nam
WorkingDirectory=/home/nam/nam-website-deploy
ExecStart=/usr/local/bin/bws run --project-id ffbc63d1-23df-41c4-a2ff-b49300cf115c -- /home/nam/.local/bin/uv run celery -A config worker --loglevel=info --concurrency=1
EnvironmentFile=/etc/nam-website/bws-token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
